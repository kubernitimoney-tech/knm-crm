# Edge reverse proxy for Kuberniti Money.
# Caddy provisions and renews free HTTPS certificates automatically.
#
# Production VPS (xxx.xxx.xxx.xxx) — DNS must point these here:
#   kubernitimoney.com            -> marketing site
#   www.kubernitimoney.com        -> redirect to apex
#   app.kubernitimoney.com        -> CRM (frontend)
#   api.kubernitimoney.com        -> Django API (+ /media/)
#
# Test / staging VPS (xxx.xxx.xxx.xxx) — DNS must point these here:
#   dev.kubernitimoney.com        -> marketing site
#   test.kubernitimoney.com       -> CRM (frontend)
#   api-test.kubernitimoney.com   -> Django API (+ /media/)
#   staging.kubernitimoney.com    -> CRM (frontend)
#   api-staging.kubernitimoney.com -> Django API (+ /media/)
#
# Same Caddyfile can be deployed on both VPS. Caddy only gets a certificate
# for hostnames whose DNS A record points at that server.

# Each environment runs as its own Docker Compose project (see
# docker-compose.prod.yml). Its django/frontend/marketing containers join the
# shared "knm-edge" network as <stack>-django, <stack>-frontend and
# <stack>-marketing, where <stack> is prod, test or staging. Only one Caddy runs
# per server (the stack deployed with --profile edge).
#
# Uploaded files (/media/*) are NOT served from disk here: Django serves them
# only through signed, expiring links.

{
	email admin@kubernitimoney.com
}

(marketing) {
	encode gzip
	reverse_proxy {args[0]}-marketing:80
}

(crm) {
	encode gzip
	reverse_proxy {args[0]}-frontend:80
}

(api) {
	encode gzip
	reverse_proxy {args[0]}-django:8000
}

# --- Production ---

kubernitimoney.com {
	import marketing prod
}

www.kubernitimoney.com {
	redir https://kubernitimoney.com{uri} permanent
}

app.kubernitimoney.com {
	import crm prod
}

api.kubernitimoney.com {
	import api prod
}

# --- Test ---

dev.kubernitimoney.com {
	import marketing test
}

test.kubernitimoney.com {
	import crm test
}

api-test.kubernitimoney.com {
	import api test
}

# --- Staging (same VPS as test, separate stack and database) ---

staging.kubernitimoney.com {
	import crm staging
}

api-staging.kubernitimoney.com {
	import api staging
}
