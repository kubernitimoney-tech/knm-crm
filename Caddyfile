# Edge reverse proxy for Kuberniti Money.
# Caddy provisions and renews free HTTPS certificates automatically.
#
# Production VPS (187.127.174.47) — DNS must point these here:
#   kubernitimoney.com            -> marketing site
#   www.kubernitimoney.com        -> redirect to apex
#   app.kubernitimoney.com        -> CRM (frontend)
#   api.kubernitimoney.com        -> Django API (+ /media/)
#
# Test / staging VPS (201.18.192.131) — DNS must point these here:
#   dev.kubernitimoney.com        -> marketing site
#   test.kubernitimoney.com       -> CRM (frontend)
#   api-test.kubernitimoney.com   -> Django API (+ /media/)
#   staging.kubernitimoney.com    -> CRM (frontend)
#   api-staging.kubernitimoney.com -> Django API (+ /media/)
#
# Same Caddyfile can be deployed on both VPS. Caddy only gets a certificate
# for hostnames whose DNS A record points at that server.

{
	email admin@kubernitimoney.com
}

(marketing) {
	encode gzip
	reverse_proxy marketing:80
}

(crm) {
	encode gzip
	reverse_proxy frontend:80
}

(api) {
	encode gzip

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy django:8000
	}
}

# --- Production ---

kubernitimoney.com {
	import marketing
}

www.kubernitimoney.com {
	redir https://kubernitimoney.com{uri} permanent
}

app.kubernitimoney.com {
	import crm
}

api.kubernitimoney.com {
	import api
}

# --- Test ---

dev.kubernitimoney.com {
	import marketing
}

test.kubernitimoney.com {
	import crm
}

api-test.kubernitimoney.com {
	import api
}

# --- Staging (same VPS as test; promote testing → staging) ---

staging.kubernitimoney.com {
	import crm
}

api-staging.kubernitimoney.com {
	import api
}
