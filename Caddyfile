# Edge reverse proxy for Kuberniti Money.
# Caddy automatically provisions and renews free HTTPS certificates.
#
# Domain mapping (primary domain: kubernitimoney.com):
#   kubernitimoney.com            -> marketing site (SPA)
#   www.kubernitimoney.com        -> redirect to apex
#   test.kubernitimoney.com       -> LMS app (frontend)
#   api-test.kubernitimoney.com   -> Django API (+ uploaded media)
#
# Reserved for production later:
#   app.kubernitimoney.com        -> LMS app
#   api.kubernitimoney.com        -> Django API
#
# IMPORTANT: change the email below to a real address for Let's Encrypt notices.

{
	email admin@kubernitimoney.com
}

# Apex: public marketing site
kubernitimoney.com {
	encode gzip
	reverse_proxy marketing:80
}

# www -> apex
www.kubernitimoney.com {
	redir https://kubernitimoney.com{uri} permanent
}

# LMS application (test)
test.kubernitimoney.com {
	encode gzip
	reverse_proxy frontend:80
}

# API backend + uploaded media (test)
api-test.kubernitimoney.com {
	encode gzip

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy django:8000
	}
}
