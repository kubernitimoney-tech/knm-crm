# Testing / staging VPS (xxx.xxx.xxx.xxx).
# Copy to backend/.env on the test server and fill in real secrets.
#   cp backend/.env.testing.example backend/.env
#
# Hosts on this VPS:
#   dev.kubernitimoney.com         marketing
#   test.kubernitimoney.com        CRM
#   api-test.kubernitimoney.com    API
#   staging.kubernitimoney.com     CRM
#   api-staging.kubernitimoney.com API

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=Asia/Kolkata
DEBUG=False
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
FIELD_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_RANDOM_STRING

ALLOWED_HOSTS=api-test.kubernitimoney.com,api-staging.kubernitimoney.com

# Browser origins allowed to call the API (test/staging CRM + marketing).
CORS_ALLOWED_ORIGINS=https://test.kubernitimoney.com,https://staging.kubernitimoney.com,https://dev.kubernitimoney.com
CORS_ALLOW_CREDENTIALS=True

# Public CRM URL used in e-sign / Video KYC emails and Digio redirect_url.
# Missing this falls back to http://localhost:3000 and the customer browser
# will show ERR_CONNECTION_REFUSED after Digio.
FRONTEND_BASE_URL=https://test.kubernitimoney.com

CSRF_TRUSTED_ORIGINS=https://api-test.kubernitimoney.com,https://api-staging.kubernitimoney.com,https://test.kubernitimoney.com,https://staging.kubernitimoney.com,https://dev.kubernitimoney.com

# Database (internal Docker network host = "postgres")
POSTGRES_DB=lms
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://lms_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/lms

# Redis / Celery (internal Docker network host = "redis")
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media / storage
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Caddy terminates TLS and forwards X-Forwarded-Proto, so Django detects HTTPS.
SECURE_SSL_REDIRECT=True

# Email — Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
SANCTION_MAILBOX_EMAIL=sanction@kubernitimoney.com
SANCTION_FROM_EMAIL=Kuberniti Money <sanction@kubernitimoney.com>
DISBURSAL_MAILBOX_EMAIL=disbursal@kubernitimoney.com
DISBURSAL_FROM_EMAIL=Kuberniti Money <disbursal@kubernitimoney.com>
CONFIRMATION_MAILBOX_EMAIL=confirmation@kubernitimoney.com
