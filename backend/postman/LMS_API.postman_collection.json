{
  "info": {
    "name": "LMS API",
    "description": "Loan Management System API v1.\n\nEnvironments:\n- LMS Local → postman/LMS_Local.postman_environment.json (http://localhost:8000/api/v1)\n- LMS Test → postman/LMS_Test.postman_environment.json (https://api-test.kubernitimoney.com/api/v1)\n\nRun Auth → Login first (or Public Lead Intake without login). For Senior Credit Manager lead-create testing, set scm_email/scm_password in the Test environment and use Auth → Login with those credentials after granting lead.create in the permission matrix.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.tokens) {",
                  "    pm.environment.set('access_token', res.data.tokens.access);",
                  "    pm.environment.set('refresh_token', res.data.tokens.refresh);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Senior Credit Manager)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{scm_email}}\",\n  \"password\": \"{{scm_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login/",
            "description": "Use after granting lead.create to senior-credit-manager in the permission matrix. Set scm_email and scm_password in the active environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.tokens) {",
                  "    pm.environment.set('access_token', res.data.tokens.access);",
                  "    pm.environment.set('refresh_token', res.data.tokens.refresh);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh/"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout/"
          }
        }
      ]
    },
