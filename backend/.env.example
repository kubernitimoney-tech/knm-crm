# Django
DJANGO_SETTINGS_MODULE=config.settings.local
TIME_ZONE=Asia/Kolkata
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
POSTGRES_DB=lms
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Use host "postgres" inside Docker Compose; use "localhost" when running Django on the host.
DATABASE_URL=postgres://lms_user:lms_password@postgres:5432/lms

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
FRONTEND_BASE_URL=http://localhost:3000

# Media / storage
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Security (production)
SECURE_SSL_REDIRECT=False

# Email — Gmail SMTP (optional; leave EMAIL_HOST empty to print mail in console)
# Use a Google App Password (not your login password): https://myaccount.google.com/apppasswords
# After changing these values, recreate containers: docker compose up -d --force-recreate django celery celery-beat
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kuberniti Money <info@kubernitimoney.com>
SERVER_EMAIL=Kuberniti Money <info@kubernitimoney.com>
SANCTION_MAILBOX_EMAIL=sanction@kubernitimoney.com
SANCTION_FROM_EMAIL=Kuberniti Money <sanction@kubernitimoney.com>
DISBURSAL_MAILBOX_EMAIL=disbursal@kubernitimoney.com
DISBURSAL_FROM_EMAIL=Kuberniti Money <disbursal@kubernitimoney.com>
CONFIRMATION_MAILBOX_EMAIL=confirmation@kubernitimoney.com

# Optional SMS for Video KYC links (not used for eSign OTP).
# Fast2SMS: SMS_PROVIDER=fast2sms and SMS_API_KEY=<authorization key>
# MSG91: SMS_PROVIDER=msg91, SMS_API_KEY=<authkey>, SMS_SENDER_ID=KNMCRM
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER_ID=KNMCRM

# Digio e-sign + video KYC (sandbox first). Never commit real secrets.
# DIGIO_ENV=sandbox defaults to API https://ext-api.digio.in and gateway https://ext.digio.in
# DIGIO_ENV=production defaults to API https://api.digio.in and gateway https://app.digio.in
# Override both when Digio issued you different hosts (no trailing slash):
# DIGIO_BASE_URL=https://ext-api.digio.in
# DIGIO_GATEWAY_BASE_URL=https://ext.digio.in
DIGIO_ENV=sandbox
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# Used as the HMAC key for X-Digio-Signature, and as the shared secret when the
# webhook URL carries it as ?token=<value>. Falls back to DIGIO_CLIENT_SECRET.
# Paste this in Digio → Webhooks (must be public HTTPS, not localhost):
# https://YOUR_PUBLIC_HOST/api/v1/webhooks/digio/?token=<DIGIO_WEBHOOK_SECRET>
DIGIO_WEBHOOK_SECRET=
DIGIO_KYC_TEMPLATE_NAME=
DIGIO_ESIGN_SIGN_TYPE=aadhaar
# Set true only for local tunnel debugging. Leave false in deployed environments.
DIGIO_WEBHOOK_ALLOW_UNSIGNED=False

# Cashfree Secure ID (Verification Suite) webhook.
# Paste this in Cashfree → Developers → Webhook (no trailing slash):
# https://api-test.kubernitimoney.com/api/v1/webhooks/cashfree
# Client secret from Cashfree → Developers → API keys, for the same mode as the URL
# (Test secret on api-test, production secret on api). No quotes.
# Leave CASHFREE_WEBHOOK_SECRET empty unless Cashfree gave you a separate key.
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
