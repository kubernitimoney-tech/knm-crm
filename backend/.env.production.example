# Production / testing environment for Kuberniti Money.
# Copy to backend/.env on the server and fill in real secrets.
#   cp backend/.env.production.example backend/.env

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=Asia/Kolkata
DEBUG=False
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Key for encrypting PII (PAN/Aadhaar). Generate a separate random string.
FIELD_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_RANDOM_STRING

# Hosts Django will answer to (the API domain).
ALLOWED_HOSTS=api-test.kubernitimoney.com

# Origins allowed to call the API from the browser (test app + marketing site).
CORS_ALLOWED_ORIGINS=https://test.kubernitimoney.com,https://kubernitimoney.com,https://www.kubernitimoney.com

# Trusted origins for CSRF (Django admin login over HTTPS behind Caddy).
CSRF_TRUSTED_ORIGINS=https://api-test.kubernitimoney.com

# Database (internal Docker network host = "postgres")
POSTGRES_DB=lms
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://lms_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/lms

# Redis / Celery (internal Docker network host = "redis")
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media / storage
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Caddy terminates TLS and forwards X-Forwarded-Proto, so Django detects HTTPS.
SECURE_SSL_REDIRECT=True

# Email — Gmail SMTP
# Use a Google App Password (not your login password): https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
