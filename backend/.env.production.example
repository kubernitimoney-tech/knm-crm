# Production VPS (187.127.174.47).
# Copy to backend/.env on the production server and fill in real secrets.
#   cp backend/.env.production.example backend/.env
#
# Hosts on this VPS:
#   kubernitimoney.com / www   marketing
#   app.kubernitimoney.com     CRM
#   api.kubernitimoney.com     API

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=Asia/Kolkata
DEBUG=False
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Key for encrypting PII (PAN/Aadhaar). Generate a separate random string.
FIELD_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_RANDOM_STRING

# Hosts Django will answer to (the API domain).
ALLOWED_HOSTS=api.kubernitimoney.com

# Browser origins allowed to call the API (production CRM + marketing).
CORS_ALLOWED_ORIGINS=https://app.kubernitimoney.com,https://kubernitimoney.com,https://www.kubernitimoney.com
CORS_ALLOW_CREDENTIALS=True

# Trusted origins for CSRF (Django admin + same-site POSTs behind Caddy).
CSRF_TRUSTED_ORIGINS=https://api.kubernitimoney.com,https://app.kubernitimoney.com,https://kubernitimoney.com,https://www.kubernitimoney.com

# Database (internal Docker network host = "postgres")
POSTGRES_DB=lms
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://lms_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/lms

# Redis / Celery (internal Docker network host = "redis")
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media / storage
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Caddy terminates TLS and forwards X-Forwarded-Proto, so Django detects HTTPS.
SECURE_SSL_REDIRECT=True

# Email — Gmail SMTP
# Use a Google App Password (not your login password): https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
