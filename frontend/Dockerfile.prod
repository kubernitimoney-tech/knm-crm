# Production build: compile the Vite SPA to static files, serve with Caddy.
# VITE_API_URL is baked in at build time, so it MUST be passed as a build arg.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
# SPA fallback: unknown paths return index.html so client-side routing works.
RUN printf ':80 {\n\troot * /srv\n\tencode gzip\n\theader Permissions-Policy "camera=*, microphone=*, geolocation=*, display-capture=*"\n\ttry_files {path} /index.html\n\tfile_server\n}\n' > /etc/caddy/Caddyfile
EXPOSE 80
